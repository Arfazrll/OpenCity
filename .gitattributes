# Normalise line endings so the Windows and Linux builds see identical files.
* text=auto eol=lf

# Windows-only scripts must keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never touch, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.ktx2 binary
*.dds binary
*.hdr binary
*.exr binary
*.ogg binary
*.wav binary
*.flac binary
*.glb binary
*.gltf binary
*.ttf binary
*.otf binary
*.pdf binary
*.zst binary
